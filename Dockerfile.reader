# Reader: the PDF reader, Speak text and Explain for phones (reader_server.py). No agents, no
# secrets in the image: Explain's Claude API key comes in at run time (docker-compose.reader.yml).
#   docker compose -f docker-compose.reader.yml up -d --build

# Giọng Kokoro (350 MB) ở stage riêng, khoá bằng checksum GitHub công bố: đổi code không phải tải
# lại, và file bị tráo giữa đường thì build hỏng chứ không chạy.
# 2026-10-26 sherpa-onnx đóng gói lại file này (checksum đổi, c5f7e2d2… → 60703707…). Đã đối chiếu:
# cả 377 file bên trong giống hệt bản cũ từng byte. Lần sau "digest mismatch": so như vậy rồi mới đổi.
FROM python:3.12-slim AS voice
ADD --checksum=sha256:60703707bc05ccd48d60e1eb723f38b07d6e474795a0b6a588d7220400e0f7a4 \
    https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/kokoro-multi-lang-v1_0.tar.bz2 \
    /tmp/voice.tar.bz2
RUN python -c "import tarfile; tarfile.open('/tmp/voice.tar.bz2').extractall('/opt/voice', filter='data')" \
    && rm /tmp/voice.tar.bz2

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    READER_DATA=/data READER_HOST=0.0.0.0 READER_PORT=8080 READER_VOICE=/opt/voice
RUN pip install --no-cache-dir starlette==1.3.1 uvicorn==0.49.0 httpx==0.28.1 sherpa-onnx==1.13.8 \
    anthropic==2.3.0
COPY --from=voice /opt/voice /opt/voice
WORKDIR /app
# Từng file một, không bao giờ `COPY . .`: thư mục dự án có .env (khoá API) — image không được mang nó.
COPY session_orchestrator.py reader_server.py ./
COPY static/orchestrator/index.html static/orchestrator/app.js static/orchestrator/logo.png \
     static/orchestrator/icon-512.png static/orchestrator/
COPY static/orchestrator/vendor/pdfjs static/orchestrator/vendor/pdfjs
RUN useradd --uid 10001 --no-create-home reader && mkdir /data && chown reader /data
USER reader
VOLUME /data
EXPOSE 8080
CMD ["python", "reader_server.py", "serve"]
